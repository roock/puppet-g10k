<%-|
  String  $cache_dir,
  String  $source_name,
  String  $source_remote,
  String  $source_basedir,
  Boolean $use_cache_fallback,
|-%>
---
# Puppet Controlled #
# DO NOT MODIFY     #
#
:cachedir: '<%= $cache_dir %>'
use_cache_fallback : <%= $use_cache_fallback %>

# A list of git repositories to create
sources:
    <%= $source_name %>:
        remote  : <%= $source_remote %>
        basedir : <%= $source_basedir %>

