<%-|
  String                         $cache_dir,
  String                         $source_name,
  String                         $source_remote,
  String                         $source_basedir,
  Boolean                        $use_cache_fallback,
  Boolean                        $use_generate_types         = false,
  Optional[Array[String]]        $postrun                    = undef,
  Optional[Hash[String, String]] $additional_settings        = undef,
  Optional[Array[String]]        $purge_levels               = undef,
  Optional[Array[String]]        $purge_whitelist            = undef,
  Optional[Array[String]]        $deployment_purge_whitelist = undef,
  Optional[String]               $forge_baseurl              = undef,
|-%>
---
# Puppet Controlled #
# DO NOT MODIFY     #
#
:cachedir: '<%= $cache_dir %>'
use_cache_fallback : <%= $use_cache_fallback %>

<% if $forge_baseurl { -%>
forge.baseUrl : <%= $forge_baseurl %>
<% } -%>

<% if $purge_levels or $purge_whitelist or $deployment_purge_whitelist { -%>
deploy :
<% if $purge_levels { -%>
  purge_levels :
  <% $purge_levels.each |$item | { -%>
    - '<%= $item %>'
  <% } -%>
<% } -%>
<% if $purge_whitelist { -%>
  purge_whitelist :
  <% $purge_whitelist.each |$item | { -%>
    - '<%= $item %>'
  <% } -%>
<% } -%>
<% if $deployment_purge_whitelist { -%>
  deployment_purge_whitelist :
  <% $deployment_purge_whitelist.each |$item | { -%>
    - '<%= $item %>'
  <% } -%>
<% } -%>
<% } -%>

# A list of git repositories to create
sources:
    <%= $source_name %>:
        remote  : <%= $source_remote %>
        basedir : <%= $source_basedir %>
    <%- if $additional_settings { -%>
    <%- $additional_settings.keys.sort.each |$setting| { -%>
        <%= $setting %> : <%= $additional_settings[$setting] %>
    <%- } -%>
    <%- } -%>

<% if $use_generate_types { -%>
postrun: 
  - '/usr/local/bin/g10k_generate_types.bash'
  - '$modifiedenvs'

<% } elsif $postrun { -%>
postrun:
<% $postrun.each |$item| { -%>
  - <%= $item %>
<% } -%>

<% } -%>
<% if ! empty($postrun) { -%>
postrun:
<% $postrun.each |$item| { -%>
  - <%= $item %>
<% } -%>
<% } -%>
