<%-|
  Integer $maxworker,
  Integer $maxextractworker,
  Boolean $is_quiet,
  Boolean $should_force,
|-%>
#!/bin/bash
/usr/local/bin/g10k -maxworker <%= $maxworker %> -maxextractworker <%= $maxextractworker %> <% if $should_force { %>-force <% } %><% if $is_quiet { %>-quiet <% } %>-config /etc/g10k.yaml

